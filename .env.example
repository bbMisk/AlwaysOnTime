# Flask Settings
FLASK_APP=app.main
FLASK_DEBUG=1
SECRET_KEY=dev_secret_key_change_this_in_production
PORT=5001

# MTA API Key (Required for real-time subway data)
# Get one here: https://api.mta.info/#/signup
MTA_API_KEY=your_mta_api_key_here

# OpenRouteService API Key (Optional - for walking routes)
# If not provided, app falls back to OSRM public API
# Get one here: https://openrouteservice.org/sign-up/
ORS_API_KEY=

# Google Maps API Key (Optional - for route comparison/debugging)
GOOGLE_MAPS_API_KEY=
